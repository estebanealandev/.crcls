---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PlusLineGrid from '../components/PlusLineGrid.astro';
import { type Locale } from '../i18n/utils';
import { dictionaries } from '../i18n/dictionaries';
import { localizedAbsoluteUrl, jsonLdString } from '../lib/seo';
import legalEn from '../i18n/locales/legalLicensing/en.json';

const DICT = dictionaries<typeof legalEn>('legalLicensing');

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = DICT[locale];
const canonicalPath = '/legal/licensing';
const pageUrl = localizedAbsoluteUrl(locale, canonicalPath);
---

<Layout
  title={t.seo.title}
  description={t.seo.description}
  dataWfPage="69ea3b293f46d55a8da1996b"
  wfScript="/js/webflow.21c96129.b139c9ba2e1a8ee4.js"
  canonicalPath={canonicalPath}
  locale={locale}
>
  <script is:inline type="application/ld+json" slot="head" set:html={jsonLdString({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": t.jsonLd.name,
    "description": t.jsonLd.description,
    "url": pageUrl,
    "inLanguage": locale,
    "about": {
      "@type": "DigitalDocument",
      "name": t.jsonLd.aboutName,
      "description": t.jsonLd.aboutDescription,
      "text": t.jsonLd.aboutText,
      "mentions": [
        {
          "@type": "ImageObject",
          "name": "LUMMI Images",
          "url": "https://www.lummi.ai/",
          "description": t.jsonLd.lummiDescription,
        },
        {
          "@type": "SoftwareApplication",
          "name": "Switzer",
          "url": "https://www.fontshare.com/",
          "applicationCategory": "Font",
          "description": t.jsonLd.switzerDescription,
        },
        {
          "@type": "SoftwareApplication",
          "name": "IBM Plex Mono",
          "url": "https://fonts.google.com/specimen/IBM+Plex+Mono",
          "applicationCategory": "Font",
          "description": t.jsonLd.ibmPlexDescription,
        },
      ],
    },
  })} />

  <Navbar locale={locale} currentPath={canonicalPath} />

  <main class="page-wrapper">
    <section class="section for-style">
      <div class="container">
        <div class="licensing-content">
          <p>{t.intro}</p>
          <div class="margin-50">
            <h2 class="licensing-title">
              {t.imageSectionLabel} — <a href="https://www.lummi.ai/" target="_blank" rel="noopener noreferrer" class="licensing-link">{t.lummiLinkLabel}</a>
            </h2>
            <div class="margin-30">
              <div class="licensing-grid">
                <img sizes="(max-width: 2528px) 100vw, 2528px" srcset="/assets/images/bg-first-alt-p-500.webp 500w, /assets/images/bg-first-alt-p-800.webp 800w, /assets/images/bg-first-alt-p-1080.webp 1080w, /assets/images/bg-first-alt-p-1600.webp 1600w, /assets/images/bg-first-alt-p-2000.webp 2000w, /assets/images/bg-first-alt.webp 2528w" alt={t.lummiImageAlt} src="/assets/images/bg-first-alt.webp" loading="lazy" />
                <img sizes="(max-width: 4800px) 100vw, 4800px" srcset="/assets/images/bg-second-p-500.webp 500w, /assets/images/bg-second-p-800.webp 800w, /assets/images/bg-second-p-1080.webp 1080w, /assets/images/bg-second-p-1600.webp 1600w, /assets/images/bg-second-p-2000.webp 2000w, /assets/images/bg-second-p-2600.webp 2600w, /assets/images/bg-second-p-3200.webp 3200w, /assets/images/bg-second.webp 4800w" alt={t.lummiImageAlt} src="/assets/images/bg-second.webp" loading="lazy" />
                <img sizes="100vw" srcset="/assets/images/Dramatic-Blue-Portrait-_1_-p-500.webp 500w, /assets/images/Dramatic-Blue-Portrait-_1_-p-800.webp 800w, /assets/images/Dramatic-Blue-Portrait-_1_-p-1080.webp 1080w, /assets/images/Dramatic-Blue-Portrait-_1_-p-1600.webp 1600w, /assets/images/Dramatic-Blue-Portrait-_1_-p-2000.webp 2000w, /assets/images/Dramatic-Blue-Portrait-_1_-p-2600.webp 2600w, /assets/images/Dramatic-Blue-Portrait-_1_-p-3200.webp 3200w, /assets/images/Dramatic-Blue-Portrait-_1_.webp 4800w" alt={t.lummiImageAlt} src="/assets/images/Dramatic-Blue-Portrait-_1_.webp" loading="lazy" />
                <img sizes="(max-width: 4800px) 100vw, 4800px" srcset="/assets/images/Vintage-Lace-Portrait-alt-p-500.webp 500w, /assets/images/Vintage-Lace-Portrait-alt-p-800.webp 800w, /assets/images/Vintage-Lace-Portrait-alt-p-1080.webp 1080w, /assets/images/Vintage-Lace-Portrait-alt-p-1600.webp 1600w, /assets/images/Vintage-Lace-Portrait-alt-p-2000.webp 2000w, /assets/images/Vintage-Lace-Portrait-alt-p-2600.webp 2600w, /assets/images/Vintage-Lace-Portrait-alt-p-3200.webp 3200w, /assets/images/Vintage-Lace-Portrait-alt.webp 4800w" alt={t.lummiImageAlt} src="/assets/images/Vintage-Lace-Portrait-alt.webp" loading="lazy" />
              </div>
            </div>
          </div>
          <div class="margin-50">
            <h2 class="licensing-title">
              {t.fontSectionLabel} — <a href="https://www.fontshare.com/" target="_blank" rel="noopener noreferrer" class="licensing-link">{t.switzerLinkLabel}</a>
            </h2>
            <div class="margin-30"><h2>{t.switzerSampleText}</h2></div>
            <div class="divider-s"></div>
            <h2 class="licensing-title">
              {t.fontSectionLabel} — <a href="https://fonts.google.com/specimen/IBM+Plex+Mono" target="_blank" rel="noopener noreferrer" class="licensing-link">{t.ibmMonoLinkLabel}</a>
            </h2>
            <h2 class="anton-text _01">{t.ibmMonoSampleText}</h2>
          </div>
        </div>
      </div>
    </section>
  </main>
  <div class="transition"><div class="transition-block"></div></div>
  <PlusLineGrid />
</Layout>
