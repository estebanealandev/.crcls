# Required in production (Railway → Variables). The contact and newsletter
# forms send through Resend (https://resend.com/api-keys) using this key.
# The circlescr.com sending domain must be verified in the Resend dashboard
# first, or outbound email will fail with a 403 from the Resend API.
RESEND_API_KEY=

# Optional overrides — sensible defaults are baked into server.mjs, so these
# only need to be set if the destination/sender address ever changes.
# CONTACT_TO_EMAIL=hello@circlescr.com
# CONTACT_FROM_EMAIL=Circles <hello@circlescr.com>

# Microsoft Clarity. The project ID is public (it travels in the tag's
# request URL), so it is not a secret and must stay PUBLIC_-prefixed.
PUBLIC_CLARITY_PROJECT_ID=xl5kif4zg9
# true => wait for a `crcls:consent` event with `detail.analytics` before loading.
PUBLIC_CLARITY_REQUIRE_CONSENT=false
# true => also load Clarity under `astro dev` (off by default).
PUBLIC_CLARITY_ENABLE_DEV=false

# Google Analytics 4 (gtag.js, no GTM). The measurement ID is public (it
# travels in the tag's request URL), so it is not a secret.
PUBLIC_GA4_MEASUREMENT_ID=G-X46ZHXCXSW
# 'granted' once a consent banner exists; until then GA4 loads cookieless/
# modeled under Consent Mode v2. See grantAnalyticsConsent() in
# src/lib/analytics/ga4.ts for the hook a future CMP should call.
PUBLIC_ANALYTICS_DEFAULT_CONSENT=denied
# true => also load GA4 under `astro dev` (off by default).
PUBLIC_GA4_ENABLE_DEV=false
