---
import { SITE_URL, SITE_NAME, GEO } from '../lib/seo';
import { DEFAULT_LOCALE, LOCALE_META, localizedAlternates, localizedPath, type Locale } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  locale?: Locale;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = "/",
  locale = DEFAULT_LOCALE,
  ogImage = "/assets/images/thumb.jpg",
  ogType = "website",
  noindex = false,
} = Astro.props;

const localizedCanonicalPath = localizedPath(locale, canonicalPath);
const canonicalUrl = new URL(localizedCanonicalPath, SITE_URL).toString();
const ogImageUrl = new URL(ogImage, SITE_URL).toString();
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1";
const alternates = localizedAlternates(canonicalPath);
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />

{alternates.map(({ tag, href }) => (
  <link rel="alternate" hreflang={tag} href={new URL(href, SITE_URL).toString()} />
))}
<link rel="alternate" hreflang="x-default" href={new URL(localizedPath(DEFAULT_LOCALE, canonicalPath), SITE_URL).toString()} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{alternates.filter((a) => a.locale !== locale).map((a) => (
  <meta property="og:locale:alternate" content={LOCALE_META[a.locale].ogLocale} />
))}
<meta property="og:type" content={ogType} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE_NAME} — AI, Product & Brand Studio in Pérez Zeledón, Costa Rica`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<meta name="geo.region" content="CR-SJ" />
<meta name="geo.placename" content={GEO.placename} />
<meta name="geo.position" content={`${GEO.latitude};${GEO.longitude}`} />
<meta name="ICBM" content={`${GEO.latitude}, ${GEO.longitude}`} />
