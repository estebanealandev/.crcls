---
// Language menu in the navbar. A <details> disclosure, so it opens and closes
// natively even without JavaScript; public/js/language-switcher.js adds
// outside-click / Escape dismissal, arrow-key navigation and the close
// animation. Real links (not a <select>) so every locale is a crawlable href.
// No flag emoji: Windows renders them as bare letters, and flags name
// countries, not languages.
import { LOCALE_META, localizedAlternates, type Locale } from '../i18n/utils';
import { versioned } from '../lib/assets';

interface Props {
  locale: Locale;
  canonicalPath: string;
  ariaLabel: string;
}

const { locale, canonicalPath, ariaLabel } = Astro.props;
// A 404 has no translated twin worth linking to (the missing page is missing in
// every language), so on it each language leads to its home page instead.
const alternates = localizedAlternates(canonicalPath === '/404' ? '/' : canonicalPath);
---

<details class="lang-switcher" data-lang-switcher>
  <summary class="lang-switcher__trigger" aria-label={`${ariaLabel}: ${LOCALE_META[locale].nativeName}`}>
    <svg class="lang-switcher__globe" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <circle cx="8" cy="8" r="6.5" />
      <path d="M1.5 8h13M8 1.5c1.8 1.8 2.7 4 2.7 6.5S9.8 12.7 8 14.5M8 1.5C6.2 3.3 5.3 5.5 5.3 8s.9 4.7 2.7 6.5" />
    </svg>
    <span class="lang-switcher__code">{locale.toUpperCase()}</span>
    <svg class="lang-switcher__chevron" viewBox="0 0 10 10" width="8" height="8" aria-hidden="true">
      <path d="M1.5 3.5 5 7l3.5-3.5" />
    </svg>
  </summary>

  <div class="lang-switcher__panel">
    <p class="lang-switcher__title" aria-hidden="true">{ariaLabel}</p>
    <ul class="lang-switcher__list" role="list" aria-label={ariaLabel}>
      {alternates.map(({ locale: loc, tag, href }, i) => (
        <li style={`--i:${i}`}>
          <a
            class="lang-switcher__option"
            href={href}
            hreflang={tag}
            lang={tag}
            data-locale={loc}
            aria-current={loc === locale ? 'true' : undefined}
          >
            <span class="lang-switcher__name">{LOCALE_META[loc].nativeName}</span>
            <span class="lang-switcher__tag">{loc.toUpperCase()}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</details>

<script is:inline defer src={versioned("/js/language-switcher.js")}></script>

<style>
  .lang-switcher {
    --ls-ease: cubic-bezier(.19, 1, .22, 1);
    --ls-radius: .75rem;
    position: relative;
    margin-left: .55rem; /* room for the trigger's hover outline next to the location */
    color: var(--colors--first-color);
  }

  /* ---------- Trigger ---------- */

  .lang-switcher__trigger {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    margin: -.4rem -.55rem;
    padding: .4rem .55rem;
    list-style: none;
    border: 1px solid transparent;
    border-radius: .55rem;
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .02em;
    line-height: 1;
    cursor: none;
    user-select: none;
    transition: background-color .3s ease, border-color .3s ease;
  }

  .lang-switcher__trigger::-webkit-details-marker {
    display: none;
  }

  .lang-switcher__trigger:hover,
  .lang-switcher[open] > .lang-switcher__trigger {
    background: rgb(255 255 255 / 7%);
    border-color: rgb(255 255 255 / 14%);
  }

  .lang-switcher__trigger:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 3px;
  }

  .lang-switcher__globe,
  .lang-switcher__chevron {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lang-switcher__globe {
    stroke-width: 1.1;
    opacity: .85;
  }

  .lang-switcher__code {
    font-variant-numeric: tabular-nums;
  }

  .lang-switcher__chevron {
    stroke-width: 1.4;
    opacity: .7;
    transition: transform .45s var(--ls-ease);
  }

  .lang-switcher[open] .lang-switcher__chevron {
    transform: rotate(180deg);
  }

  /* ---------- Panel (glass) ---------- */

  .lang-switcher__panel {
    position: absolute;
    top: calc(100% + .9rem);
    right: -.55rem;
    z-index: 2;
    width: max-content;
    min-width: 13rem;
    max-width: calc(100vw - 2rem);
    padding: .4rem;
    border: 1px solid rgb(255 255 255 / 13%);
    border-radius: var(--ls-radius);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 7%), rgb(255 255 255 / 2%) 40%),
      rgb(14 14 14 / 58%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 9%),
      0 24px 60px -18px rgb(0 0 0 / 70%),
      0 2px 8px rgb(0 0 0 / 25%);
    transform-origin: top right;
  }

  .lang-switcher[open] .lang-switcher__panel {
    animation: ls-in .45s var(--ls-ease) both;
  }

  .lang-switcher.is-closing .lang-switcher__panel {
    animation: ls-out .18s ease-in both;
  }

  @keyframes ls-in {
    from { opacity: 0; transform: translateY(-.4rem) scale(.96); }
    to { opacity: 1; transform: none; }
  }

  @keyframes ls-out {
    from { opacity: 1; transform: none; }
    to { opacity: 0; transform: translateY(-.25rem) scale(.98); }
  }

  .lang-switcher__title {
    margin: 0;
    padding: .55rem .7rem .45rem;
    font-family: var(--font--second-font);
    font-size: .65rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .45;
  }

  .lang-switcher__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang-switcher__list li {
    margin: 0;
    opacity: 1;
    font-size: inherit;
  }

  .lang-switcher[open] .lang-switcher__list li {
    animation: ls-item .5s var(--ls-ease) both;
    animation-delay: calc(var(--i) * 30ms + 40ms);
  }

  @keyframes ls-item {
    from { opacity: 0; transform: translateY(-.25rem); }
    to { opacity: 1; transform: none; }
  }

  .lang-switcher__option {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: .6rem .7rem;
    border-radius: calc(var(--ls-radius) - .4rem);
    color: var(--colors--first-color);
    font-size: .9rem;
    font-weight: 500;
    letter-spacing: -.2px;
    line-height: 1.1;
    text-decoration: none;
    cursor: none;
    opacity: .72;
    transition: background-color .25s ease, opacity .25s ease;
  }

  .lang-switcher__option:hover,
  .lang-switcher__option:focus-visible {
    background: rgb(255 255 255 / 8%);
    opacity: 1;
    outline: none;
  }

  .lang-switcher__option:focus-visible {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 35%);
  }

  .lang-switcher__option[aria-current] {
    opacity: 1;
    background: rgb(255 255 255 / 5%);
  }

  /* Current locale: a short bar on the left edge. */
  .lang-switcher__option[aria-current]::before {
    content: "";
    position: absolute;
    left: -.05rem;
    top: 50%;
    width: 3px;
    height: 1rem;
    border-radius: 3px;
    background: var(--colors--first-color);
    translate: 0 -50%;
  }

  .lang-switcher__tag {
    font-family: var(--font--second-font);
    font-size: .68rem;
    letter-spacing: .06em;
    opacity: .5;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-switcher[open] .lang-switcher__panel,
    .lang-switcher.is-closing .lang-switcher__panel,
    .lang-switcher[open] .lang-switcher__list li {
      animation: none;
    }
  }

  @media screen and (max-width: 479px) {
    .lang-switcher__code {
      display: none;
    }
  }
</style>
