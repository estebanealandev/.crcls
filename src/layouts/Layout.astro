---
import '../styles/fonts.css';
import '../styles/circles.shared.css';

interface Props {
  title: string;
  description?: string;
  dataWfPage: string;
  wfScript?: string;
  preloadImage?: string | string[];
}

const {
  title,
  description = "Circles is a Pérez Zeledón-based studio building AI systems, digital products, and commerce platforms for brands that intend to last.",
  dataWfPage,
  wfScript = "/js/webflow.e6aeb930.103a96742c08bc67.js",
  preloadImage,
  canonicalPath = "/"
} = Astro.props;

const SITE_URL = "https://www.circlescr.com";
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
---
<!DOCTYPE html>
<html data-wf-page={dataWfPage} lang="en">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta content={description} name="description" />
  <link rel="canonical" href={canonicalUrl} />
  <meta content={title} property="og:title" />
  <meta content={description} property="og:description" />
  <meta content={`${SITE_URL}/assets/images/thumb.jpg`} property="og:image" />
  <meta content={canonicalUrl} property="og:url" />
  <meta content="Circles" property="og:site_name" />
  <meta content="en_US" property="og:locale" />
  <meta content={title} name="twitter:title" />
  <meta content={description} name="twitter:description" />
  <meta content={`${SITE_URL}/assets/images/thumb.jpg`} name="twitter:image" />
  <meta property="og:type" content="website" />
  <meta content="summary_large_image" name="twitter:card" />
  <meta content="width=device-width, initial-scale=1" name="viewport" />

  {preloadImage && (
    Array.isArray(preloadImage) ? (
      preloadImage.map(img => <link rel="preload" as="image" href={img} fetchpriority="high" />)
    ) : (
      preloadImage.split(',').map(img => img.trim()).map(img => <link rel="preload" as="image" href={img} fetchpriority="high" />)
    )
  )}
  
  <link rel="preconnect" href="https://videos.pexels.com" crossorigin />
  
  <link rel="preload" href="/assets/fonts/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/Switzer-VariableItalic.woff2" as="font" type="font/woff2" crossorigin />


  
  <style is:inline>
    @media (min-width:992px) {
      html.w-mod-js:not(.w-mod-ix) [data-w-id="1920b008-b90d-a6b7-e374-41086d36403a"] {
        opacity: 0;
      }
    }
  </style>
  <style is:inline>
    html.w-mod-js:not(.w-mod-ix3) :is(.page-title, .h2.fade, .nav-text, .line-absolute, .font-change, #ab-1, #ab-3, #ab-2, #ab-4, .main-content, .h2._02, .h2._01, .thumbnail-small) {
      visibility: hidden !important;
    }
    .w-webflow-badge {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
    @media (prefers-reduced-motion: reduce) {
      * {
        animation-delay: 0s !important;
        animation-duration: 0s !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0s !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
  

  <script is:inline type="text/javascript">
    !function(o, c) {
      var n = c.documentElement, t = " w-mod-";
      n.className += t + "js", ("ontouchstart" in o || o.DocumentTouch && c instanceof DocumentTouch) && (n.className += t + "touch")
    }(window, document);
  </script>
  
  <link href="/assets/images/favicon.svg" rel="shortcut icon" type="image/svg+xml" />
  <link href="/assets/images/favicon.svg" rel="apple-touch-icon" />
  
  <slot name="head" />
</head>
<body>
  <slot />
  
  <script is:inline defer src="/js/jquery-3.5.1.min.js" type="text/javascript"></script>
  <script is:inline defer src="/js/webflow.schunk.f2efb3c5440a81cf.js" type="text/javascript"></script>
  <script is:inline defer src="/js/webflow.schunk.1f640fbb9b1f9d96.js" type="text/javascript"></script>
  <script is:inline defer src={wfScript} type="text/javascript"></script>
  <script is:inline defer src="/js/gsap.min.js" type="text/javascript"></script>
  <script is:inline defer src="/js/SplitText.min.js" type="text/javascript"></script>
  <script is:inline defer src="/js/ScrollTrigger.min.js" type="text/javascript"></script>
  <script is:inline defer src="/js/forms.js" type="text/javascript"></script>
  <script is:inline defer src="/js/CustomEase.min.js" type="text/javascript"></script>
</body>
</html>
