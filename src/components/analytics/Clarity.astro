---
/**
 * Circles — Microsoft Clarity loader (consent-ready, CSP-friendly).
 * Mounted once in the base layout's <head>.
 * .env:
 *   PUBLIC_CLARITY_PROJECT_ID=xl5kif4zg9
 *   PUBLIC_CLARITY_REQUIRE_CONSENT=false   # true => wait for consent (CMP)
 *   PUBLIC_CLARITY_ENABLE_DEV=false        # true => also load under astro dev
 */
const projectId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID as string | undefined;
const enableInDev = import.meta.env.PUBLIC_CLARITY_ENABLE_DEV === 'true';
const shouldLoad = Boolean(projectId) && (import.meta.env.PROD || enableInDev);
---

{shouldLoad && (
  <script>
    import { wireClarityEvents } from './clarity-events';

    const projectId: string | undefined = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
    const requireConsent = import.meta.env.PUBLIC_CLARITY_REQUIRE_CONSENT === 'true';

    let loaded = false;
    function loadClarity() {
      if (loaded || !projectId) return;
      loaded = true;
      (function (c: any, l: Document, a: string, r: string, i: string, t?: any, y?: any) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', projectId);
    }

    window.clarityConsent = function (granted: boolean) {
      if (granted) {
        loadClarity();
        if (typeof window.clarity === 'function') window.clarity('consent', true);
      } else if (typeof window.clarity === 'function') {
        window.clarity('consent', false);
      }
    };

    if (requireConsent) {
      window.addEventListener('crcls:consent', function (e: Event) {
        const detail = (e as CustomEvent).detail as { analytics?: boolean } | undefined;
        if (detail?.analytics) window.clarityConsent?.(true);
      });
    } else {
      loadClarity();
    }

    wireClarityEvents();
  </script>
)}
