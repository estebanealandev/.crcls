---
import { LOCALE_META, localizedAlternates, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  canonicalPath: string;
  ariaLabel: string;
}

const { locale, canonicalPath, ariaLabel } = Astro.props;
const alternates = localizedAlternates(canonicalPath);
---

<div class="lang-switcher">
  <label class="lang-switcher-label" for="lang-switcher-select">
    <span aria-hidden="true">{LOCALE_META[locale].flag}</span>
    <span class="lang-switcher-code">{locale.toUpperCase()}</span>
  </label>
  <select id="lang-switcher-select" class="lang-switcher-select" aria-label={ariaLabel} data-lang-switcher>
    {alternates.map(({ locale: loc, href }) => (
      <option value={href} selected={loc === locale}>
        {LOCALE_META[loc].flag} {LOCALE_META[loc].nativeName}
      </option>
    ))}
  </select>
</div>

<script is:inline defer src="/js/language-switcher.js"></script>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
    position: relative;
  }

  .lang-switcher-label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    pointer-events: none;
  }

  .lang-switcher-code {
    font-variant-numeric: tabular-nums;
  }

  .lang-switcher-select {
    appearance: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    border: 0;
    background: none;
    color: inherit;
    font-size: 1rem;
  }

  .lang-switcher-select:focus-visible + .lang-switcher-label,
  .lang-switcher:focus-within .lang-switcher-label {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  @media screen and (max-width: 479px) {
    .lang-switcher-code {
      display: none;
    }
  }
</style>
