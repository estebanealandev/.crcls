{
  "name": "circles-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/gen-csp.mjs",
    "preview": "astro preview",
    "astro": "astro",
