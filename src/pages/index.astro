      {
        "@type": "Service",
        "name": "Advanced Tech",
        "position": 3
      },
      {
        "@type": "Service",
        "name": "Systems & Integration",
        "position": 4
      }
    ]
  },
  "review": [
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "jobTitle": "Founder, Atelier"
      },
      "reviewBody": "Circles⁺ didn't just redesign our brand, they restructured how everything connects. From design to performance, it finally feels like one system."
    },
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Sophie Laurent",
        "jobTitle": "Property Developer"
      },
      "reviewBody": "Working with Circles⁺ brought clarity to our entire digital presence. Every detail feels intentional, and everything performs as it should."
    },
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Daniel Moore",
        "jobTitle": "Founder, Northlane"
      },
      "reviewBody": "What stood out was their ability to simplify complexity. Strategy, design, and tech came together seamlessly, and the results followed."
    }
  ]
}
