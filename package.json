  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "astro": "^7.0.7"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "lighthouse": "^13.4.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
