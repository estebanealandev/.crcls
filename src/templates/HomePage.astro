---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import PlusLineGrid from '../components/PlusLineGrid.astro';
import HoverTooltip from '../components/HoverTooltip.astro';
import ProjectList from '../components/ProjectList.astro';
import BlogCard from '../components/BlogCard.astro';
import HeroExtended from '../components/hero/HeroExtended.astro';
import '../styles/services-hover.css';
import { localizedPath, type Locale } from '../i18n/utils';
import { dictionaries, slugDictionaries } from '../i18n/dictionaries';
import { localizedAbsoluteUrl, jsonLdString, BUSINESS_ID, WEBSITE_ID } from '../lib/seo';
import { versioned } from '../lib/assets';
import { requirePost, postImageSrcset } from '../data/posts';
import homeEn from '../i18n/locales/home/en.json';

const DICT = dictionaries<typeof homeEn>('home');
// Featured journal grid: a 3-post subset of POSTS, in the order authored in the original export.
const JOURNAL_SLUGS = [
  'custom-software-vs-saas-what-to-build',
  'brand-clarity-is-a-product-requirement',
  'reliable-ai-automation-in-production',
] as const;
const JOURNAL_IMAGE_WRAP_ID = 'd3b3af6e-4d1d-6513-f03c-603d82b3f68e';
const POST_COPY = slugDictionaries<{ title: string }>('posts', JOURNAL_SLUGS);

// Service cards: structural ids/classes/numbers, zipped by index with t.services.cards.
// Use svc-* classes (not Webflow combo `_01`…`_04`) so IX hover/SplitText cannot bind and fight our hover.
const SERVICE_CARDS = [
  { id: '03e8d322-fa65-c83a-1494-de81e392097b', cardClass: 'svc-02', mediaId: 'ab-2', number: '(02)', service: 'performance-marketing' },
  { id: '5be1a0e4-80cc-d391-e0ac-1023f6fe72bf', cardClass: 'svc-04', mediaId: 'ab-4', number: '(04)', service: 'ai-systems' },
  { id: '61aeaeac-9eea-9402-3da6-bfcd9385ff20', cardClass: 'svc-03', mediaId: 'ab-3', number: '(03)', service: 'product-commerce' },
  { id: '5fba5656-a942-3b54-dd2c-c48361763b21', cardClass: 'svc-01', mediaId: 'ab-1', number: '(01)', service: 'brand-direction' },
] as const;

// Testimonial slides: locale-independent portrait assets, zipped by index with t.testimonials.
const TESTIMONIAL_IMAGES = [
  {
    src: '/assets/images/Contemplative_Man_in_Stylish_Attire.webp',
    sizes: '100vw',
    srcset: '/assets/images/Contemplative_20Man_20in_20Stylish_20Attire-p-500.webp 500w, /assets/images/Contemplative_20Man_20in_20Stylish_20Attire-p-800.webp 800w, /assets/images/Contemplative_20Man_20in_20Stylish_20Attire-p-1080.webp 1080w, /assets/images/Contemplative_Man_in_Stylish_Attire.webp 1200w',
  },
  {
    src: '/assets/images/Stylish_Sunglasses_Portrait.webp',
    sizes: '100vw',
    srcset: '/assets/images/Stylish_20Sunglasses_20Portrait-p-500.webp 500w, /assets/images/Stylish_20Sunglasses_20Portrait-p-800.webp 800w, /assets/images/Stylish_20Sunglasses_20Portrait-p-1080.webp 1080w, /assets/images/Stylish_Sunglasses_Portrait.webp 1200w',
  },
  {
    src: '/assets/images/Minimalist_Portrait__3_.webp',
    sizes: '100vw',
    srcset: '/assets/images/Minimalist_20Portrait_20_3_-p-500.webp 500w, /assets/images/Minimalist_20Portrait_20_3_-p-800.webp 800w, /assets/images/Minimalist_20Portrait_20_3_-p-1080.webp 1080w, /assets/images/Minimalist_Portrait__3_.webp 1200w',
  },
] as const;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = DICT[locale];
const canonicalPath = '/';
const pageUrl = localizedAbsoluteUrl(locale, canonicalPath);

// Structural ids/classes and localized copy are zipped by index; a length
// mismatch between the JSON and the constants above must fail the build.
const serviceCards = SERVICE_CARDS.map((card, i) => {
  const copy = t.services.cards[i];
  if (!copy) throw new Error(`home.services.cards[${i}] is missing for locale "${locale}"`);
  return { ...card, copy };
});
const testimonials = t.testimonials.map((testimonial, i) => {
  const image = TESTIMONIAL_IMAGES[i];
  if (!image) throw new Error(`TESTIMONIAL_IMAGES[${i}] has no asset for locale "${locale}"`);
  return { ...testimonial, image };
});
---

<Layout
  title={t.seo.title}
  description={t.seo.description}
  dataWfPage="69ea3b293f46d55a8da19968"
  wfScript="/js/webflow.a41d47af.3073163fb57e81fa.js"
  preloadImage="/assets/videos/hero/backdrop-thumb.jpg"
  canonicalPath={canonicalPath}
  locale={locale}
>
  <script is:inline type="application/ld+json" slot="head" set:html={jsonLdString({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": t.seo.jsonLdName,
    "description": t.seo.jsonLdDescription,
    "url": pageUrl,
    "inLanguage": locale,
    "about": { "@id": BUSINESS_ID },
    "isPartOf": { "@id": WEBSITE_ID },
    "mainEntity": {
      "@type": "ItemList",
      "name": t.seo.servicesListName,
      "itemListElement": t.seo.services.map((name, i) => ({
        "@type": "Service",
        "name": name,
        "position": i + 1,
      })),
    },
  })} />

  <Navbar locale={locale} currentPath={canonicalPath} blurEffectId="514259e0-c596-3b68-1ac0-dd45c0eed9eb" />
  <main style="display:contents">

  <HeroExtended locale={locale} />
  <div data-w-id="38d4477e-1853-8c35-ea4f-9aa9a42bb615"></div>

  <div class="content-effect _01">
    <section class="section">
      <div class="container effect">
        <div class="work-grid">
          <h2 id="w-node-_1384ecdd-252f-705d-ca11-26efec102b6a-8da19968" class="h2 fade cnt">{t.works.title}<span class="light-oc">©</span></h2>
        </div>
      </div>
    </section>
  </div>
  <section class="section-work">
    <ProjectList locale={locale} />
  </section>
  <div data-w-id="341b604c-50aa-f364-4667-c5c84c5dcf2d"></div>

  <div class="content-effect _02">
    <section class="section _01">
      <div class="container effect">
        <div>
          <h2 class="page-title">{t.services.prefix}© — {t.services.boldText} <span class="gray-color">{t.services.grayText}</span></h2>
        </div>
        <div class="divider-l"></div>
        <div class="service-grid">
          <div id="w-node-_8cf6445e-d523-cfbb-514e-d6804a66c33c-8da19968">
            <h3 data-w-id="a010a520-cb6c-2dbc-fcd3-83689247abf2" style="opacity:0" class="page-title-small _01 hdi">{t.services.quote.text}<br />
              <br />
              <span class="gray-color">{t.services.quote.attribution}</span>
              <br />
            </h3>
          </div>
          {serviceCards.map((card) => (
            <div
              id={`w-node-_${card.id}-8da19968`}
              data-crcls-service={card.service}
              data-svc-media={card.mediaId}
              class={`service-card ${card.cardClass}`}
            >
              <h3 class="service-title">{card.copy.titleLine1}<br />{card.copy.titleLine2}</h3>
              <p class="font-change" data-svc-items>{card.copy.items.map((item, j) => <>{item}{j < card.copy.items.length - 1 && <br />}</>)}</p>
              <h3 class="service-title second">{card.number}</h3>
            </div>
          ))}
        </div>
      </div>
      <div class="service-image-wrapper">
        <img src="/assets/images/Dramatic-Blue-Portrait-_1_.webp" loading="eager" alt="" class="svc-background" data-svc-bg="ab-1" />
        <img src="/assets/images/Red_Fashion_Close-Up_poster.0000000.jpg" loading="eager" alt="" class="svc-background" data-svc-bg="ab-2" />
        <img src="/assets/images/02.webp" loading="eager" alt="" class="svc-background" data-svc-bg="ab-3" />
        <img src="/assets/images/01.webp" loading="eager" alt="" class="svc-background" data-svc-bg="ab-4" />
        <div class="gradient-top"></div>
        <div class="gradient-top bottom"></div>
        <div class="about-overlay"></div>
      </div>
    </section>
  </div>
  <div data-w-id="fbdfe94c-3fb4-ef6f-d873-fb0120bbe5f9"></div>

  <div class="content-effect _03">
    <section class="section">
      <div class="container effect">
        <div>
          <h2 class="h2 fade cnt sml">{t.growthStatement.text}</h2>
        </div>
      </div>
    </section>
  </div>
  <div data-w-id="bb9ba485-4e3d-46d9-7d31-ceb345c66e03"></div>

