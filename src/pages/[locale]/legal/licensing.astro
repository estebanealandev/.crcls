---
import type { InferGetStaticPropsType } from 'astro';
import LegalLicensingPage from '../../../templates/LegalLicensingPage.astro';
import { secondaryLocalePaths } from '../../../i18n/utils';

export function getStaticPaths() {
  return secondaryLocalePaths();
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale } = Astro.props;
---

<LegalLicensingPage locale={locale} />
