---
import type { InferGetStaticPropsType } from 'astro';
import ProjectPage from '../../../templates/ProjectPage.astro';
import { PROJECT_PAGES } from '../../../data/projects';
import { localeSlugPaths } from '../../../i18n/utils';

export function getStaticPaths() {
  return localeSlugPaths(PROJECT_PAGES);
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale, slug } = Astro.props;
---

<ProjectPage locale={locale} slug={slug} />
